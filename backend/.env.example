ENVIRONMENT=development
DEBUG=true
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# SERVER ONLY. NEVER PUT THIS IN FLUTTER.
GEMINI_API_KEY=

GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_PREMIUM_IMAGE_MODEL=gemini-3-pro-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

DEFAULT_IMAGE_SIZE=4K
DEFAULT_VIDEO_RESOLUTION=1080p

MEDIA_DIR=/tmp/creatorpilot-media
MEDIA_BASE_URL=http://localhost:8000/media

ALLOW_MOCK_PROVIDERS=true
JWT_SECRET=dev-only-insecure-secret-change-me
